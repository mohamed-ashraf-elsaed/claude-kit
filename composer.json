{
    "name": "mohamed-ashraf-elsaed/claude-kit",
    "description": "One command sets up Claude Code (and any AI coding agent) on a Laravel project: engineering rules, a quality gate (PHPStan, Pint, Pest), skills, git hooks, and stack-aware frontend tooling.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://mohamedashrafelsaed.com/projects/claude-kit/",
    "keywords": [
        "laravel",
        "claude",
        "claude-code",
        "anthropic",
        "ai",
        "ai-agents",
        "llm",
        "mcp",
        "cursor",
        "github-copilot",
        "code-quality",
        "quality-gate",
        "static-analysis",
        "phpstan",
        "larastan",
        "pint",
        "pest",
        "code-style",
        "coding-standards",
        "git-hooks",
        "developer-tools",
        "developer-experience",
        "scaffolding",
        "conventions"
    ],
    "authors": [
        {
            "name": "Mohamed Ashraf Elsaed",
            "email": "hello@mohamedashrafelsaed.com",
            "homepage": "https://mohamedashrafelsaed.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/mohamed-ashraf-elsaed/claude-kit/issues",
        "source": "https://github.com/mohamed-ashraf-elsaed/claude-kit",
        "docs": "https://claude-kit.mohamedashrafelsaed.com/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel/prompts": "^0.1 || ^0.2 || ^0.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "suggest": {
        "laravel/pint": "Runs the code-style check the installer configures in pint.json.",
        "larastan/larastan": "Adds Laravel-aware static analysis to the generated phpstan.neon.",
        "phpstan/phpstan-strict-rules": "Adds the strict rule set the generated phpstan.neon can include.",
        "pestphp/pest": "Runs the test gate and the generated architecture test suite.",
        "pestphp/pest-plugin-laravel": "Adds the Laravel test helpers the Pest gate uses.",
        "laravel/boost": "Adds the Laravel Boost MCP server that claude-kit wires into .mcp.json."
    },
    "autoload": {
        "psr-4": {
            "MohamedAshrafElsaed\\ClaudeKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MohamedAshrafElsaed\\ClaudeKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "types:check": "phpstan analyse --no-progress",
        "test": "pest --compact",
        "test:coverage": "pest --coverage --min=80 --compact",
        "check": [
            "@lint:check",
            "@types:check",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MohamedAshrafElsaed\\ClaudeKit\\ClaudeKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
